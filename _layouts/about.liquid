---
layout: default
---
<div class="post">
  <article>
    <section class="home-hero">
      <div class="hero-copy">
        <p class="hero-kicker">{{ page.subtitle }}</p>
        <h1>Jiayu <span>Yang</span><small>杨家宇</small></h1>
        <p class="hero-lead">Ph.D. student building a causal understanding of how language models reason, remember, and learn.</p>
        <div class="hero-actions">
          <a class="hero-button primary" href="{{ '/assets/pdf/jiayu-yang-cv.pdf' | relative_url }}"
            >Download CV <i class="fa-solid fa-arrow-down"></i
          ></a>
          <a class="hero-button" href="{{ '/publications/' | relative_url }}">Publications <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        {% if page.social %}
          <div class="hero-social" aria-label="Social links">{% include social.liquid %}</div>
        {% endif %}
      </div>

      {% if page.profile and page.profile.image %}
        <div class="hero-portrait">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% capture sizes %}(min-width: {{ site.max_width }}) 320px, (min-width: 768px) 32vw, 88vw{% endcapture %}
          {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes=sizes alt="Portrait of Jiayu Yang" cache_bust=true %}
          <div class="portrait-note"><span></span>{{ page.profile.more_info }}</div>
        </div>
      {% endif %}
    </section>

    <section class="home-intro">{{ content }}</section>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <div class="section-heading">
        <div>
          <span>Updates</span>
          <h2>Latest news</h2>
        </div>
        <a href="{{ '/news/' | relative_url }}">View all <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <div class="section-heading publications-heading">
        <div>
          <span>Research</span>
          <h2>Selected publications</h2>
        </div>
        <a href="{{ '/publications/' | relative_url }}">View all <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
